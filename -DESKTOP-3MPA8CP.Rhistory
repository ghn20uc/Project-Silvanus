y = "Reported MMI",
title = "Reported MMI vs Hypocentral Distance"
)
ggplot(data_sf, aes(x = Rhypo_km, y = reported_mmi)) +
geom_count() +
theme_minimal() +
labs(
x = "Hypocentral Distance (Km)",
