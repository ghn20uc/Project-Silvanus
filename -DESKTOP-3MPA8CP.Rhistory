title = "Comparison of Felt MMI Central Tendency Measures"
)
felt_per_earthquake <- data |>
group_by(publicid) |>
summarise(
felt_reports = sum(
felt_mmi_1_reports,
felt_mmi_2_reports,
felt_mmi_3_reports,
felt_mmi_4_reports,
felt_mmi_5_reports,
felt_mmi_6_reports,
felt_mmi_7_reports,
felt_mmi_8_reports,
na.rm = TRUE
)
)
ggplot(
felt_per_earthquake,
aes(x = reorder(publicid, felt_reports), y = felt_reports)
) +
geom_col() +
theme_minimal() +
labs(
x = "Earthquake",
y = "Number of Felt Reports",
title = "Felt Reports for Each Earthquake"
) +
theme(
axis.text.x = element_blank(),
axis.ticks.x = element_blank()
)
felt_per_earthquake |>
slice_max(felt_reports, n = 30) |>
ggplot(
aes(x = reorder(publicid, felt_reports), y = felt_reports)
) +
geom_col() +
theme_minimal() +
labs(
x = "Earthquake",
y = "Number of Felt Reports",
title = "Top 30 Earthquakes by Number of Felt Reports"
) +
theme(
axis.text.x = element_text(
angle = 45,
hjust = 1
)
)
data_sf |>
distinct(publicid, felt_report_count) |>
ggplot(aes(x = felt_report_count)) +
geom_histogram(binwidth = 1000) +
theme_minimal() +
labs(
x = "Total Felt Reports",
y = "Number of Earthquakes",
title = "Distribution of Felt Reports per Earthquake"
)
data_sf |>
distinct(publicid, felt_report_count) |>
filter(
felt_report_count >= 0,
felt_report_count <= 30
) |>
ggplot(aes(x = felt_report_count)) +
geom_histogram(binwidth = 1) +
scale_x_continuous(breaks = 0:30) +
theme_minimal() +
labs(
x = "Total Felt Reports",
y = "Number of Earthquakes",
title = "Earthquakes with 0–30 Felt Reports"
)
data_sf |>
distinct(publicid, felt_report_count) |>
filter(
felt_report_count >= 0,
felt_report_count <= 1000
) |>
ggplot(aes(x = felt_report_count)) +
geom_histogram(binwidth = 1) +
scale_x_continuous(breaks = 0:1000) +
theme_minimal() +
labs(
x = "Total Felt Reports",
y = "Number of Earthquakes",
title = "Earthquakes with 0–30 Felt Reports"
)
write_parquet(data_sf, "data_de.parquet")
View(data_sf)
coords <- sf::st_coordinates(data_sf)
data_export <- data_sf |>
mutate(
longitude = coords[, 1],
