)
data_sf |>
st_drop_geometry() |>
distinct(publicid, mt_Mw) |>
count(mt_Mw)
data |>
select(felt_mean, felt_median, felt_mode) |>
pivot_longer(
everything(),
names_to = "measure",
values_to = "MMI"
) |>
ggplot(aes(x = measure, y = MMI)) +
geom_boxplot() +
theme_minimal() +
labs(
x = "Measure of Central Tendency",
