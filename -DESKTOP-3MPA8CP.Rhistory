library(arrow)
library(MASS)
library(tidyverse)
library(sf)
library(leaps)
library(lme4)
data <- read_parquet("data.parquet")
data_sf <- data |>
st_as_sf(
coords = c("longitude", "latitude"),
crs = 4326,
remove = FALSE
)
vs30_data <- read_parquet("data_processed/vs30_site_lookup.parquet")
vs30_sf <- vs30_data |>
st_as_sf(
coords = c("report_longitude", "report_latitude"),
crs = 4326,
remove = FALSE
) |>
filter(!is.na(Vs30_raw))
nearest_id <- st_nearest_feature(data_sf, vs30_sf)
data_sf <- data_sf |>
mutate(
Vs30_raw = vs30_sf$Vs30_raw[nearest_id]
)
bc <- boxcox(
lm(reported_mmi ~ felt_median, data = data_sf)
)
best_lambda <- bc$x[which.max(bc$y)]
best_lambda
data_sf <- data_sf |>
mutate(
mmi_bc_1.3 = (reported_mmi^(-1.3) - 1) / (-1.3)
)
model_bc <- lm(mmi_bc_1.3 ~ felt_median, data = data_sf)
plot(model_bc)
summary(model_bc)
data_sf_5 <- data_sf |>
filter(report_count >= 5)
bc <- boxcox(
lm(reported_mmi ~ felt_median, data = data_sf_5)
)
best_lambda <- bc$x[which.max(bc$y)]
best_lambda
model_bc_5 <- lm(log(reported_mmi) ~ felt_median, data = data_sf)
plot(model_bc_5)
summary(model_bc_5)
best <- regsubsets(
mmi_bc_1.3 ~ event_depth_km + Rhypo_km + felt_median + Vs30_raw,
data = data_sf,
nvmax = 4
)
summary(best)
plot(best)
summary(best)$bic
best_lm_1.3 <- lm(mmi_bc_1.3 ~ event_depth_km + Rhypo_km + felt_median,
data = data_sf
)
summary(best_lm_1.3)
plot(best_lm_1.3)
best <- regsubsets(
log(reported_mmi) ~ event_depth_km + Rhypo_km + felt_median + Vs30_raw,
data = data_sf_5,
nvmax = 4
)
summary(best)
plot(best)
summary(best)$bic
best_lm <- lm(log(reported_mmi) ~ Rhypo_km + felt_median,
data = data_sf_5
)
summary(best_lm)
plot(best_lm)
library(lme4)
model <- lmer(
log(reported_mmi) ~ Rhypo_km + event_depth_km + Vs30_raw +
(1 | publicid),
data = data_sf
)
